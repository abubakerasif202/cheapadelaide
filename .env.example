NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=

# --- SEO monitoring collector (scripts/seo) ---------------------------------
# Never put real values for these in a NEXT_PUBLIC_ variable or commit them.
# See GOOGLE_CLOUD_SEO_SETUP.md for how to obtain each one.
GOOGLE_CLOUD_PROJECT_ID=
BIGQUERY_DATASET=seo_monitoring
BIGQUERY_TABLE=search_console_daily
BIGQUERY_LOCATION=australia-southeast1
SEARCH_CONSOLE_SITE_URL=
# Only needed for scheduled/server-side runs (Cloud Run/Functions) that can't
# use `gcloud auth application-default login`. Points at a service account
# key file; never commit the key itself.
# GOOGLE_APPLICATION_CREDENTIALS=
